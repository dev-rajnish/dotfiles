#!/usr/bin/env python3
"""
Shoelace Unified Master Template Renderer (sl-render)
Dynamically renders templates from shoelace.toml using MiniJinja and deep-merged TOML tokens.
"""

import os
import sys
import json
import shutil
import argparse
import subprocess
from pathlib import Path

try:
    import tomllib
except ImportError:
    print("❌ Error: Python 3.11+ is required for the built-in 'tomllib' module.")
    sys.exit(1)


def get_root_dir() -> Path:
    """Finds the root directory of the dotfiles repository."""
    env_dir = os.environ.get("SHOELACE_DIR") or os.environ.get("DOTFILES_DIR")
    if env_dir:
        return Path(env_dir).expanduser().resolve()

    script_path = Path(__file__).resolve()
    potential_root = script_path.parents[1]
    if (potential_root / "shoelace.toml").exists() or (potential_root / "tokens").exists():
        return potential_root

    cwd = Path.cwd()
    if (cwd / "shoelace.toml").exists() or (cwd / "tokens").exists():
        return cwd

    return script_path.parent.parent


def find_minijinja_cmd() -> list[str]:
    """Finds the command to execute minijinja-cli."""
    if shutil.which("minijinja-cli"):
        return ["minijinja-cli"]
    if shutil.which(","):
        return [",", "minijinja-cli"]
    if shutil.which("nix-shell"):
        return ["nix-shell", "-p", "minijinja", "--run", "minijinja-cli"]

    print("❌ Error: 'minijinja-cli' not found in PATH or via ','.")
    sys.exit(1)


def deep_merge(target: dict, source: dict) -> None:
    """Recursively merges source dict into target dict."""
    for key, value in source.items():
        if isinstance(value, dict) and isinstance(target.get(key), dict):
            deep_merge(target[key], value)
        else:
            target[key] = value


def collect_all_tokens(root_dir: Path, tokens_dirs: list[str]) -> dict:
    """Scans and deep-merges all TOML token files into a unified context dictionary."""
    unified_context = {}
    for d in tokens_dirs:
        dir_path = (root_dir / d) if not Path(d).is_absolute() else Path(d)
        if not dir_path.exists():
            continue

        for toml_path in sorted(dir_path.rglob("*.toml")):
            parts = toml_path.parts
            if "themes" in parts or "templates" in parts or "config.lock" in parts:
                continue
            if toml_path.name in ("shoelace.toml", "shoelace.config", "file.toml"):
                continue

            try:
                with open(toml_path, "rb") as f:
                    data = tomllib.load(f)
                    deep_merge(unified_context, data)
            except Exception as e:
                print(f"⚠ Warning reading {toml_path}: {e}", file=sys.stderr)

    return unified_context


def get_category_for_mapping(app: str, tmpl: str) -> str:
    """Classifies a template mapping into theme, appearance, shell, or pkgs."""
    tmpl_lower = tmpl.lower()
    app_lower = app.lower()

    if app_lower == "pkgs" or tmpl_lower.startswith("pkgs/") or tmpl_lower.endswith(".nix.j2"):
        return "pkgs"
    if "color" in tmpl_lower or "theme" in tmpl_lower:
        return "theme"
    if app_lower in ("fish", "bash", "zsh", "nu", "shell") or any(k in tmpl_lower for k in ("alias", "path", "env")):
        return "shell"
    return "appearance"


def render_templates(category_filter: str | None = None, quiet: bool = False) -> int:
    """Renders templates specified in shoelace.toml using dynamic tokens."""
    root_dir = get_root_dir()
    config_file = root_dir / "shoelace.toml"

    if not config_file.exists():
        print(f"  \033[31m✖\033[0m Configuration not found at: {config_file}")
        sys.exit(1)

    with open(config_file, "rb") as f:
        shoelace_cfg = tomllib.load(f)

    paths_cfg = shoelace_cfg.get("paths", {})
    templates_dir = root_dir / paths_cfg.get("templates_dir", "templates")
    config_dir = root_dir / paths_cfg.get("config_dir", "config")
    tokens_dirs = paths_cfg.get("tokens_dirs", ["tokens"])

    # 1. Collect unified token context
    context = collect_all_tokens(root_dir, tokens_dirs)
    json_context = json.dumps(context)

    # 2. Extract mappings
    mappings = []
    for key, val in shoelace_cfg.items():
        if key == "paths" or not isinstance(val, list):
            continue

        app_name = "" if key == "mappings" else key
        for entry in val:
            if isinstance(entry, dict):
                tmpl = entry.get("tmpl") or entry.get("template", "")
                dest = entry.get("dest") or entry.get("destination", "")
                entry_app = entry.get("app") or entry.get("app_name", app_name)

                if tmpl and dest:
                    cat = get_category_for_mapping(entry_app, tmpl)
                    if cat == "pkgs":
                        full_tmpl = tmpl
                        full_dest = dest
                    else:
                        full_tmpl = f"{entry_app}/{tmpl}" if (entry_app and not tmpl.startswith(f"{entry_app}/")) else tmpl
                        full_dest = f"{entry_app}/{dest}" if (entry_app and not dest.startswith(f"{entry_app}/")) else dest

                    if category_filter is None or category_filter == cat:
                        mappings.append({"tmpl": full_tmpl, "dest": full_dest, "category": cat})

    minijinja_cmd = find_minijinja_cmd()
    alejandra_cmd = shutil.which("alejandra")
    rendered_count = 0

    for m in mappings:
        tmpl_path = templates_dir / m["tmpl"]
        dest_path = (root_dir / m["dest"]) if m["category"] == "pkgs" or m["dest"].startswith("modules/") else (config_dir / m["dest"])

        if not tmpl_path.exists():
            if not quiet:
                print(f"  \033[33m⚠\033[0m Missing template: {m['tmpl']} at {tmpl_path}")
            continue

        dest_path.parent.mkdir(parents=True, exist_ok=True)
        cmd = [*minijinja_cmd, "--format", "json", str(tmpl_path), "-", "-o", str(dest_path)]

        try:
            proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            _, stderr = proc.communicate(input=json_context)

            if proc.returncode == 0:
                if m["category"] == "pkgs" and alejandra_cmd:
                    subprocess.run([alejandra_cmd, "-q", str(dest_path)], capture_output=True)

                if not quiet:
                    display_dest = str(dest_path.relative_to(root_dir))
                    print(f"  \033[1;32m✓\033[0m Rendered: \033[1m{m['tmpl']}\033[0m -> {display_dest}")
                rendered_count += 1
            else:
                print(f"  \033[31m✖\033[0m Failed to render {m['tmpl']}:\n{stderr}")
        except Exception as e:
            print(f"  \033[31m✖\033[0m Execution error rendering {m['tmpl']}: {e}")

    return rendered_count


def main():
    parser = argparse.ArgumentParser(description="Shoelace Unified Master Template Renderer")
    parser.add_argument("--theme", action="store_true", help="Render theme color templates only")
    parser.add_argument("--appearance", action="store_true", help="Render appearance/UI templates only")
    parser.add_argument("--shell", action="store_true", help="Render shell templates only")
    parser.add_argument("--pkgs", action="store_true", help="Render Nix package manifests only")
    parser.add_argument("-q", "--quiet", action="store_true", help="Suppress verbose output")
    args = parser.parse_args()

    category = None
    title = "Master Renderer (sl-render)"
    if args.theme:
        category = "theme"
        title = "Theme Renderer (theme-render)"
    elif args.appearance:
        category = "appearance"
        title = "Appearance Renderer (appearance-render)"
    elif args.shell:
        category = "shell"
        title = "Shell Renderer (shell-render)"
    elif args.pkgs:
        category = "pkgs"
        title = "Package Renderer (pkg-render)"

    if not args.quiet:
        print(f"\033[1;36m─── 👟 Shoelace {title} ───\033[0m")

    count = render_templates(category_filter=category, quiet=args.quiet)

    if not args.quiet:
        print(f"\n\033[1;32m✨ Complete:\033[0m {count} templates rendered successfully.\n")


if __name__ == "__main__":
    main()
