#!/usr/bin/env python3
"""
Shoelace Package Modules Renderer (pkg-render)
Renders modules/pkgs/*.nix from tokens/pkgs/*.toml manifests using MiniJinja.
"""

import sys
import subprocess
from pathlib import Path

script_dir = Path(__file__).resolve().parent
sl_render = script_dir / "sl-render"
args = [sys.executable, str(sl_render), "--pkgs"] + sys.argv[1:]
sys.exit(subprocess.run(args).returncode)
