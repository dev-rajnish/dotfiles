#!/usr/bin/env python3
"""
Shoelace Python Theme Switcher (theme-switcher)
Selects theme from themes/*.toml, updates tokens/theme.toml, & renders theme templates.
"""

import os
import sys
import shutil
import tempfile
import argparse
import subprocess
from pathlib import Path

try:
    import tomllib
except ImportError:
    print("❌ Error: Python 3.11+ is required for the built-in 'tomllib' module.")
    sys.exit(1)


def get_root_dir() -> Path:
    """Finds the root directory of the dotfiles repository."""
    env_dir = os.environ.get("SHOELACE_DIR") or os.environ.get("DOTFILES_DIR")
    if env_dir:
        return Path(env_dir).expanduser().resolve()

    script_path = Path(__file__).resolve()
    potential_root = script_path.parents[1]
    if (potential_root / "shoelace.toml").exists() or (potential_root / "themes").exists():
        return potential_root

    cwd = Path.cwd()
    if (cwd / "shoelace.toml").exists() or (cwd / "themes").exists():
        return cwd

    return script_path.parent.parent


def get_available_themes(themes_dir: Path) -> list[dict]:
    """Loads all themes from the themes/ directory."""
    themes = []
    if not themes_dir.exists():
        return themes

    for theme_file in sorted(themes_dir.glob("*.toml")):
        try:
            with open(theme_file, "rb") as f:
                data = tomllib.load(f)
                if "name" in data:
                    data["_file"] = theme_file
                    themes.append(data)
        except Exception as e:
            print(f"⚠ Warning: Could not parse theme {theme_file.name}: {e}", file=sys.stderr)

    themes.sort(key=lambda t: t.get("name", "").lower())
    return themes


def apply_theme(theme_query: str, root_dir: Path) -> bool:
    """Applies a theme by updating tokens/theme.toml and invoking theme-render."""
    themes_dir = root_dir / "themes"
    themes = get_available_themes(themes_dir)

    selected = None
    q = theme_query.lower()
    for t in themes:
        t_name = t.get("name", "").lower()
        t_display = t.get("display_name", "").lower()
        if q == t_name or q == t_display or q == t_name.replace("-", " ") or q == t.get("_file", Path()).stem.lower():
            selected = t
            break

    if not selected:
        print(f"\033[1;31m❌ Error:\033[0m Theme '{theme_query}' not found in {themes_dir}")
        return False

    c = selected.get("colors", {})
    bg = c.get("background", "#1e1e2e")
    fg = c.get("foreground", "#cdd6f4")
    cursor = c.get("cursor", fg)
    color0 = c.get("color0", bg)
    color1 = c.get("color1", "#f38ba8")
    color2 = c.get("color2", "#a6e3a1")
    color3 = c.get("color3", "#f9e2af")
    color4 = c.get("color4", "#89b4fa")
    color5 = c.get("color5", "#cba6f7")
    color6 = c.get("color6", "#94e2d5")
    color7 = c.get("color7", fg)
    color8 = c.get("color8", "#6c7086")
    color9 = c.get("color9", color1)
    color10 = c.get("color10", color2)
    color11 = c.get("color11", "#fab387")
    color12 = c.get("color12", color4)
    color13 = c.get("color13", color5)
    color14 = c.get("color14", color6)
    color15 = c.get("color15", fg)
    accent = c.get("accent", color4)

    name = selected.get("name", "custom")
    display_name = selected.get("display_name", name)
    polarity = selected.get("polarity", "dark")

    toml_lines = [
        "# =============================================================================",
        "#  Theme, Palette & Color Tokens (tokens/theme.toml)",
        "#  Auto-managed by theme-switcher",
        "# =============================================================================",
        "",
        f'theme = "{name}"',
        f'polarity = "{polarity}"',
        "",
        "[palette]",
        f'bg = "{bg}"',
        f'bg_alt = "{color0}"',
        f'fg = "{fg}"',
        f'fg_muted = "{color8}"',
        f'cursor = "{cursor}"',
        f'primary = "{accent}"',
        f'red = "{color1}"',
        f'green = "{color2}"',
        f'blue = "{color4}"',
        f'yellow = "{color3}"',
        f'color3 = "{color3}"',
        'shadow = "#00000080"',
        f'overlay_backdrop = "{bg}e0"',
        "",
        "[[ansi_colors]]",
        'name = "color0"',
        f'hex = "{color0}"',
        "",
        "[[ansi_colors]]",
        'name = "color1"',
        f'hex = "{color1}"',
        "",
        "[[ansi_colors]]",
        'name = "color2"',
        f'hex = "{color2}"',
        "",
        "[[ansi_colors]]",
        'name = "color3"',
        f'hex = "{color3}"',
        "",
        "[[ansi_colors]]",
        'name = "color4"',
        f'hex = "{color4}"',
        "",
        "[[ansi_colors]]",
        'name = "color5"',
        f'hex = "{color5}"',
        "",
        "[[ansi_colors]]",
        'name = "color6"',
        f'hex = "{color6}"',
        "",
        "[[ansi_colors]]",
        'name = "color7"',
        f'hex = "{color7}"',
        "",
        "[[ansi_colors]]",
        'name = "color8"',
        f'hex = "{color8}"',
        "",
        "[[ansi_colors]]",
        'name = "color9"',
        f'hex = "{color9}"',
        "",
        "[[ansi_colors]]",
        'name = "color10"',
        f'hex = "{color10}"',
        "",
        "[[ansi_colors]]",
        'name = "color11"',
        f'hex = "{color11}"',
        "",
        "[[ansi_colors]]",
        'name = "color12"',
        f'hex = "{color12}"',
        "",
        "[[ansi_colors]]",
        'name = "color13"',
        f'hex = "{color13}"',
        "",
        "[[ansi_colors]]",
        'name = "color14"',
        f'hex = "{color14}"',
        "",
        "[[ansi_colors]]",
        'name = "color15"',
        f'hex = "{color15}"',
        "",
        "[borders]",
        f'active = "{accent}"',
        f'inactive = "{color8}"',
        f'urgent = "{color1}"',
        "",
    ]

    target_file = root_dir / "tokens" / "theme.toml"
    target_file.parent.mkdir(parents=True, exist_ok=True)
    with open(target_file, "w", encoding="utf-8") as f:
        f.write("\n".join(toml_lines))

    print(f"\033[1;32m✔ Applied theme:\033[0m \033[1m{display_name}\033[0m ({polarity})")

    # Run theme-render (or sl-render)
    theme_render_script = root_dir / "bin" / "theme-render"
    if theme_render_script.exists():
        subprocess.run([str(theme_render_script)])
    else:
        sl_render_script = root_dir / "bin" / "sl-render"
        if sl_render_script.exists():
            subprocess.run([str(sl_render_script), "--theme"])

    # Reload desktop applications
    subprocess.run("bash -c 'kill -SIGUSR1 $(pgrep kitty) 2>/dev/null || true'", shell=True)
    subprocess.run("wayle panel restart 2>/dev/null || true", shell=True)
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-i", "preferences-desktop-theme", "🌠 Theme Switcher", f"Switched to {display_name}"], stderr=subprocess.DEVNULL)

    return True


def run_fuzzel_menu(root_dir: Path):
    """Launches fuzzel dmenu to interactively pick a theme."""
    themes_dir = root_dir / "themes"
    themes = get_available_themes(themes_dir)

    if not themes:
        print("No themes available.")
        return

    name_map = {}
    menu_lines = []
    for t in themes:
        icon = "🌄 " if t.get("polarity") == "light" else "🌌 "
        dname = t.get("display_name", t.get("name"))
        name = t.get("name")
        label = f"{icon} {dname:<22} ({name})"
        menu_lines.append(label)
        name_map[label] = name

    fuzzel_cmd = shutil.which("fuzzel")
    if not fuzzel_cmd:
        print("fuzzel not installed, listing themes instead:")
        for t in themes:
            print(f"  • {t.get('name')}")
        return

    try:
        proc = subprocess.Popen(
            [fuzzel_cmd, "--dmenu", "--prompt", "🎨 Theme: "],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True,
        )
        stdout, _ = proc.communicate(input="\n".join(menu_lines))
        choice = stdout.strip()
        if choice and choice in name_map:
            apply_theme(name_map[choice], root_dir)
    except Exception as e:
        print(f"Error launching menu: {e}")


def main():
    parser = argparse.ArgumentParser(description="Shoelace Python Theme Switcher")
    parser.add_argument("-l", "--list", action="store_true", help="List all available themes")
    parser.add_argument("-s", "--set", dest="theme_name", help="Set and apply a theme by name")
    parser.add_argument("theme_positional", nargs="?", help="Theme name to apply (positional)")
    args = parser.parse_args()

    root_dir = get_root_dir()

    if args.list:
        themes = get_available_themes(root_dir / "themes")
        print("\n\033[1;36m=== 🎨 Available Desktop Themes ===\033[0m")
        for t in themes:
            polarity = t.get("polarity", "dark")
            tag = "\033[33m[light]\033[0m" if polarity == "light" else "\033[34m[dark]\033[0m"
            tname = t.get("name", "")
            dname = f"({t.get('display_name', tname)})"
            print(f"  • \033[1m{tname:<20}\033[0m {dname:<25} {tag}")
        print(f"\nTotal: {len(themes)} themes available in themes/\n")
        return

    target = args.theme_name or args.theme_positional
    if target:
        apply_theme(target, root_dir)
    else:
        run_fuzzel_menu(root_dir)


if __name__ == "__main__":
    main()
