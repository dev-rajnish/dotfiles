#!/usr/bin/env bash
# config-sync: script to manage config locking, reverting, and symlinking

set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_DIR="$DIR/config"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

command="$1"

case "$command" in
    config-symlink-to-xdgconfig|symlink)
        echo "Symlinking configs from $CONFIG_DIR to $XDG_CONFIG_HOME..."
        mkdir -p "$XDG_CONFIG_HOME"
        for item in "$CONFIG_DIR"/*; do
            if [ -e "$item" ]; then
                base="$(basename "$item")"
                ln -sfn "$item" "$XDG_CONFIG_HOME/$base"
                echo "Symlinked $base"
            fi
        done
        echo "Done."
        ;;
    *)
        echo "Usage: $0 {config-symlink-to-xdgconfig|symlink}"
        exit 1
        ;;
esac
