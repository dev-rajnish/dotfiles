#!/usr/bin/env python3
"""
Shoelace Theme Template Renderer (theme-render)
Renders all color palette and theme templates from shoelace.toml using dynamic tokens.
"""

import sys
import subprocess
from pathlib import Path

script_dir = Path(__file__).resolve().parent
sl_render = script_dir / "sl-render"
args = [sys.executable, str(sl_render), "--theme"] + sys.argv[1:]
sys.exit(subprocess.run(args).returncode)
