#!/usr/bin/env bash
# =============================================================================
#  Wallpaper Manager (bin/wallpaper)
#  Updates ~/sl/assets/wallpaper.jpg and manages wbg daemon
# =============================================================================

set -euo pipefail

TARGET="$HOME/sl/assets/wallpaper.jpg"

# 1. If an image path is provided (e.g. called by Waypaper post_command "$1"):
if [ -n "${1:-}" ] && [ -f "${1/#\~/$HOME}" ]; then
    SRC="${1/#\~/$HOME}"
    mkdir -p "$(dirname "$TARGET")"
    if [ "$(realpath "$SRC" 2>/dev/null)" != "$(realpath "$TARGET" 2>/dev/null)" ]; then
        cp -f "$SRC" "$TARGET"
    fi
    pkill -x wbg 2>/dev/null || true
    wbg -s "$TARGET" </dev/null >/dev/null 2>&1 &
    disown
    echo "✔ Wallpaper updated: $TARGET"
    exit 0
fi

# 2. Options
case "${1:-}" in
    --restore|restore)
        pkill -x wbg 2>/dev/null || true
        wbg -s "$TARGET" </dev/null >/dev/null 2>&1 &
        disown
        echo "✔ Wallpaper restored via wbg"
        ;;
    --gui|gui|"")
        if command -v waypaper &>/dev/null; then
            exec waypaper
        elif [ -f "$TARGET" ]; then
            pkill -x wbg 2>/dev/null || true
            wbg -s "$TARGET" </dev/null >/dev/null 2>&1 &
            disown
        else
            echo "Usage: wallpaper [IMAGE_PATH|--restore|--gui]"
            exit 1
        fi
        ;;
    *)
        echo "Usage: wallpaper [IMAGE_PATH|--restore|--gui]"
        exit 1
        ;;
esac
