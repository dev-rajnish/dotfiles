// =============================================================================
//  Niri Scrollable-Tiling Wayland Compositor Configuration
//  Main Entry Point - Modular Configuration Index
// =============================================================================
//
//  Structure of ~/.config/niri/:
//    ├── config.kdl              --> Main configuration index (includes all modules)
//    └── niri.d/
//        ├── env.kdl             --> Environment & Session variables
//        ├── input.kdl           --> Keyboard, Mouse, Touchpad & Gestures
//        ├── outputs.kdl         --> Display monitor resolution & scaling
//        ├── layout.kdl          --> Window gaps, column widths & layout rules
//        ├── colors.kdl          --> Theme colors, focus rings & borders
//        ├── animations.kdl      --> Window animations & custom GLSL shaders
//        ├── window-rules.kdl    --> Window rules, blur & app-specific overrides
//        ├── keybinds.kdl        --> Keyboard shortcuts & media keys
//        ├── exec.kdl            --> Startup applications & autostart scripts
//        └── misc.kdl            --> CSD preferences, screenshots & overlays
//
// =============================================================================

// 01. Environment & Session Variables
include "niri.d/env.kdl"

// 02. Input Devices & Focus Behavior
include "niri.d/input.kdl"

// 03. Monitor Outputs & Scaling
include "niri.d/outputs.kdl"

// 04. Window Layout & Geometry
include "niri.d/layout.kdl"

// 05. Theme Colors & Visual Accents
include "niri.d/colors.kdl"

// 06. Animations & Custom Shaders
//include "niri.d/animations.kdl"

// 07. Window Rules & Geometry Overrides
include "niri.d/window-rules.kdl"

// 08. Keyboard Binds & Shortcuts
include "niri.d/keybinds.kdl"

// 09. Startup Applications & Services
include "niri.d/exec.kdl"

// 10. Miscellaneous Preferences & Screenshot Path
include "niri.d/misc.kdl"
