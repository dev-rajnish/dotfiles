// Auto-generated from Stylix base16 theme & 2-desktop-theme-vars.nix - Do not edit manually
layout {
    gaps 6
    background-color "#131721"

    border {
        width 1
        active-color "#59c2ff"
        inactive-color "#3e4b59"
        urgent-color "#f07178"
    }

    focus-ring {
        width 1
        active-color "#59c2ff"
        inactive-color "#3e4b59"
        urgent-color "#f07178"
    }

    shadow {
        color "#00000080"
    }

    tab-indicator {
        active-color "#59c2ff"
        inactive-color "#3e4b59"
        urgent-color "#f07178"
    }

    insert-hint {
        color "#59c2ff80"
    }
}

overview {
    backdrop-color "#131721e0"
}
