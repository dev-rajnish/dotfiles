// =============================================================================
//  Environment & Session Variables
// =============================================================================

environment {
    // Wayland & Display Setup
    DISPLAY ":0"
    GDK_BACKEND "wayland"
    QT_QPA_PLATFORM "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"

    // Fontconfig Fix for NixOS
    //FONTCONFIG_FILE "/nix/store/c54dqc4iza3ccyflb4zy9b4hxg1c9v40-fontconfig-etc/etc/fonts/fonts.conf"

    // Mozilla / Firefox Wayland integration
    MOZ_ENABLE_WAYLAND "1"

    // Qt Theme Integration
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_QPA_PLATFORMTHEME_QT6 "qt6ct"

    // Custom Session Identifiers
    niri_env "modular"
}

