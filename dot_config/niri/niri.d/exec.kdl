// =============================================================================
//  Startup Applications & Autostart Services
// =============================================================================

// Sync Wayland display variables with D-Bus and systemd for portals & file picker
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "DISPLAY" "XDG_SESSION_TYPE"

// Main autostart script
spawn-at-startup "brightnessctl" "s" "80%"
spawn-at-startup "sh" "-c" "~/.config/wm-script/autostart.sh"


spawn-at-startup "swaybg" "-i" "/home/rsh/.config/niri/niri.d/1.png" "-m" "fill"

// Additional background services can be added below:
// spawn-at-startup "waybar"
// spawn-at-startup "mako"
