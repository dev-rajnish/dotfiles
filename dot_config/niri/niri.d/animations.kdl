// =============================================================================
//  Animations & Custom GLSL Shaders
//  Configured with Material 3 Expressive Physics (Ultra-Smooth & Relaxed)
// =============================================================================

animations {
    // Global animation pacing multiplier (1.2 provides a relaxed, cinematic cadence)
    slowdown 1.2

    // -------------------------------------------------------------------------
    // 01. Workspace Switch (M3 Expressive Spatial Spring)
    // Silky, spacious workspace slide with a soft, cushioned finish
    // -------------------------------------------------------------------------
    workspace-switch {
        spring damping-ratio=0.76 stiffness=200 epsilon=0.0001
    }

    // -------------------------------------------------------------------------
    // 02. Horizontal View Movement (M3 Expressive View Scroll Spring)
    // Ultra-smooth horizontal pan across window columns with gentle deceleration
    // -------------------------------------------------------------------------
    horizontal-view-movement {
        spring damping-ratio=0.78 stiffness=220 epsilon=0.0001
    }

    // -------------------------------------------------------------------------
    // 03. Window Movement (M3 Expressive Spatial Drag & Drop Spring)
    // Tactile, organic weight and smooth, springy momentum on window swap
    // -------------------------------------------------------------------------
    window-movement {
        spring damping-ratio=0.74 stiffness=210 epsilon=0.0001
    }

    // -------------------------------------------------------------------------
    // 04. Window Resize (M3 Expressive Elastic Resize Spring)
    // Velvety elasticity and soft feedback while adjusting window boundaries
    // -------------------------------------------------------------------------
    window-resize {
        spring damping-ratio=0.76 stiffness=200 epsilon=0.0001
    }

    // -------------------------------------------------------------------------
    // 05. Overview Open/Close (M3 Expressive Emphasized Spatial Spring)
    // Luxurious, cinematic zoom out/in when toggling workspace overview
    // -------------------------------------------------------------------------
    overview-open-close {
        spring damping-ratio=0.74 stiffness=160 epsilon=0.0001
    }

    // -------------------------------------------------------------------------
    // 06. Config Notification (M3 Expressive Pop-in Spring)
    // Soft, tactile pop-in for system and config notifications
    // -------------------------------------------------------------------------
    config-notification-open-close {
        spring damping-ratio=0.72 stiffness=280 epsilon=0.0001
    }

    // -------------------------------------------------------------------------
    // 07. Window Open (M3 Expressive Container Expansion Shader + Spring)
    // Slow, luxurious scale-up transform with smooth full-length fade-in
    // -------------------------------------------------------------------------
    window-open {
        spring damping-ratio=0.74 stiffness=170 epsilon=0.0001
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;

                // Material 3 Expressive scale-up from center (0.80 -> 1.0)
                float scale = 0.80 + 0.20 * p;
                vec2 center = vec2(0.5, 0.5);
                vec2 coords = (coords_geo.xy - center) / scale + center;

                // Edge boundary check
                if (coords.x < 0.0 || coords.x > 1.0 || coords.y < 0.0 || coords.y > 1.0) {
                    return vec4(0.0);
                }

                // Sample texture
                vec3 coords_tex = niri_geo_to_tex * vec3(coords, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);

                // Silky, full-duration opacity fade-in
                float alpha = smoothstep(0.0, 0.90, p);
                return color * alpha;
            }
        "
    }

    // -------------------------------------------------------------------------
    // 08. Window Close (M3 Expressive Container Collapse Shader + Spring)
    // Gentle receding scale-down transform with smooth, full-length exit dissolve
    // -------------------------------------------------------------------------
    window-close {
        spring damping-ratio=0.76 stiffness=180 epsilon=0.0001
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;

                // Material 3 Expressive scale-down to center (1.0 -> 0.80)
                float scale = 1.0 - 0.20 * p;
                vec2 center = vec2(0.5, 0.5);
                vec2 coords = (coords_geo.xy - center) / scale + center;

                // Edge boundary check
                if (coords.x < 0.0 || coords.x > 1.0 || coords.y < 0.0 || coords.y > 1.0) {
                    return vec4(0.0);
                }

                // Sample texture
                vec3 coords_tex = niri_geo_to_tex * vec3(coords, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);

                // Silky, full-duration exit dissolve
                float alpha = 1.0 - smoothstep(0.05, 0.95, p);
                return color * alpha;
            }
        "
    }
}
