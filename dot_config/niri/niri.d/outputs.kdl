// =============================================================================
//  Outputs & Displays Configuration
// =============================================================================
//
//  Configure resolution, scaling, refresh rate, and positioning for displays.
//  If left unconfigured, Niri will automatically detect and configure all
//  connected displays (eDP, HDMI, DP, Virtual) with their native resolution.
//
//  Run `niri msg outputs` in a terminal to inspect available display names.
//
//  Example:
//  output "eDP-1" {
//      mode "1920x1080@60.000"
//      scale 1.0
//      transform "normal"
//      position x=0 y=0
//  }
//
//  output "HDMI-A-1" {
//      mode "2560x1440@144.000"
//      scale 1.0
//      position x=1920 y=0
//  }

// Custom display override example:
// output "eDP-1" {
//     mode "1920x1200@60.003"
//     scale 1.00
//     position x=0 y=0
// }
