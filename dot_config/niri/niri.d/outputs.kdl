// =============================================================================
//  Outputs & Displays Configuration
// =============================================================================
//
//  Configure resolution, scaling, refresh rate, and positioning for displays.
//  Run `niri msg outputs` in a terminal to inspect available display names.
//
//  Example:
//  output "eDP-1" {
//      mode "1920x1080@60.000"
//      scale 1.0
//      transform "normal"
//      position x=0 y=0
//  }

// output "eDP-1" {
//     // Uncomment and customize based on your display:
//     // mode "1920x1080@60.000"
//     // scale 1.0
// }


output "eDP-1" {
    mode "1920x1200@60.003"
    scale 1.00
    position x=0 y=0
}
