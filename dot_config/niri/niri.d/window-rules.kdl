// =============================================================================
//  Window Rules & Application Behavior
// =============================================================================

// Global Window Appearance Rules
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    draw-border-with-background false
}
blur {
    passes 2
    offset 4.0
    noise 0.01
    saturation 1.5
}
// -----------------------------------------------------------------------------
// 🌑 Inactive / Background Windows (Deep Dark Dimming behind Active Popups)
// -----------------------------------------------------------------------------
window-rule {
    match is-focused=false
    opacity 0.75
    draw-border-with-background true
}

// -----------------------------------------------------------------------------
// 🪟 Floating Popup Windows, Modals & Dialogs (Elevated Deep Shadow)
// -----------------------------------------------------------------------------
window-rule {
    match is-floating=true
    opacity 1.0
    draw-border-with-background false
    shadow {
        on
        softness 10
        spread 15
        offset x=0 y=12
        color "#000000e0"
    }
}

// Workaround: WezTerm Initial Configure Bug
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Open Floating Windows (Picture-in-Picture, Waypaper, Volume Control, Dialogs)
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match title="Waypaper"
    match title="Volume Control"

    open-floating true
}

// Privacy & Security: Block Password Managers from Screen Capture
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"
}

// =============================================================================
// Workspace Declarations
// =============================================================================
workspace "browser"
workspace "terminal"
workspace "editor"

// =============================================================================
// Workspace Assignments
// =============================================================================

// Web Browsers -> Workspace 1 (browser)
window-rule {
    match app-id="firefox"
    match app-id="org.mozilla.firefox"
    match app-id="zen"
    match app-id="zen-beta"
    match app-id="zen-browser"
    match app-id="qutebrowser"
    match app-id="org.qutebrowser.qutebrowser"
    match app-id="google-chrome"
    match app-id="chromium"
    match app-id="brave-browser"
    match app-id="librewolf"
    match app-id="tor-browser"

    open-on-workspace "browser"
}

// Kitty Terminal -> Workspace 2 (terminal)
window-rule {
    match app-id="kitty"

    open-on-workspace "terminal"
}

// Neovim -> Workspace 3 (editor)
window-rule {
    match app-id="nvim"
    match app-id="neovim"
    match app-id="neovide"
    match title=r#"(?i)nvim"#

    open-on-workspace "editor"
}
