// =============================================================================
//  Theme Colors & Visual Accents (Tokyo Night Theme)
// =============================================================================

layout {
    // Dark Tokyo Night surface background behind windows
    background-color "#16161e"

    // Focus Ring Colors (Active Window Highlight)
    focus-ring {
        active-color   "#7aa2f7"
        inactive-color "#1f2335"
        urgent-color   "#f7768e"
    }

    // Window Border Colors
    border {
        active-color   "#7aa2f7"
        inactive-color "#1f2335"
        urgent-color   "#f7768e"
    }

    // Window Shadow Color
    shadow {
        color "#00000090"
    }
}

// Overview Mode Backdrop (Tokyo Night Theme)
overview {
    backdrop-color "#0f0f17e0"
}
