{
  // Waybar Main Configuration
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "margin-top": 4,
  "margin-bottom": 0,
  "margin-left": 6,
  "margin-right": 6,

  // External Modular Definitions
  "include": [
    "~/.config/waybar/modules/niri.jsonc",
    "~/.config/waybar/modules/system.jsonc",
    "~/.config/waybar/modules/hardware.jsonc",
    "~/.config/waybar/modules/custom.jsonc"
  ],

  // Left Modules Section
  "modules-left": [
    "custom/home",
    "niri/workspaces",
    "niri/window"
  ],

  // Center Modules Section
  "modules-center": [
    "clock"
  ],

  // Right Modules Section
  "modules-right": [
    "custom/media",
    "tray",
    "custom/clipboard",
    "custom/swaync",
    "custom/wallpaper",
    "custom/screenshot",
    "idle_inhibitor",
    "network",
    "pulseaudio",
    "backlight",
    "cpu",
    "memory",
    "temperature",
    "battery",
    "power-profiles-daemon",
    "custom/wlogout"
  ]
}
