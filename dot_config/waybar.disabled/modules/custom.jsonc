{
  "custom/home": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "fuzzel"
  },
  "custom/swaync": {
    "format": "",
    "tooltip-format": "Notification Panel",
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -t",
    "on-click-middle": "~/.config/swaync/scripts/notify_count.sh"
  },
  "custom/clipboard": {
    "format": "",
    "tooltip-format": "Open Clipboard",
    "on-click": "nwg-clipman"
  },
  "custom/wallpaper": {
    "format": "󰸉",
    "tooltip-format": "Change Wallpaper",
    "on-click": "waypaper"
  },
  "custom/screenshot": {
    "format": "",
    "tooltip-format": "Take Screenshot",
    "on-click": "~/.config/wm-script/screenshot.sh"
  },
  "custom/picker": {
    "format": "",
    "tooltip-format": "Color Picker",
    "on-click": "hyprpicker"
  },
  "custom/media": {
    "format": "{icon} {text}",
    "return-type": "json",
    "max-length": 40,
    "format-icons": {
      "spotify": "",
      "default": "🎜"
    },
    "escape": true,
    "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null"
  },
  "custom/wlogout": {
    "format": "󰳁",
    "tooltip-format": "Logout Menu",
    "on-click": "wlogout"
  }
}
