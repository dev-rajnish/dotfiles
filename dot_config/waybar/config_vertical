{
  "layer": "top",
  "position": "right",
  "width": 32,
  "spacing": 4,

  "include": [
    "~/.config/waybar/modules/niri.jsonc",
    "~/.config/waybar/modules/system.jsonc",
    "~/.config/waybar/modules/hardware.jsonc",
    "~/.config/waybar/modules/custom.jsonc"
  ],

  "modules-left": [
    "custom/home",
    "niri/workspaces",
    "custom/media"
  ],

  "modules-center": [
    "custom/swaync",
    "clock#vertical",
    "tray"
  ],

  "modules-right": [
    "custom/clipboard",
    "network",
    "custom/screenshot",
    "custom/wallpaper",
    "idle_inhibitor",
    "pulseaudio",
    "temperature",
    "battery",
    "power-profiles-daemon",
    "custom/wlogout"
  ]
}
