{
  "cpu": {
    "interval": 5,
    "format": " {usage}%",
    "tooltip": true
  },
  "memory": {
    "interval": 10,
    "format": " {percentage}%",
    "tooltip-format": "RAM Used: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)"
  },
  "temperature": {
    "thermal-zone": 2,
    "critical-threshold": 80,
    "format": " {temperatureC}°C",
    "format-critical": " {temperatureC}°C",
    "tooltip-format": "System Thermal: {temperatureC}°C"
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": ["󰁺", "󰁽", "󰂀", "󰂁", "󰁹"],
    "tooltip-format": "{timeTo} ({capacity}%)"
  },
  "battery#bat2": {
    "bat": "BAT2"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power Profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  }
}
