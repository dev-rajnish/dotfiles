{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#c0caf5",
    "margin": 2
  },
  "block_quote": {
    "color": "#7aa2f7",
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#bb9af7",
    "bold": true
  },
  "h1": {
    "prefix": "# ",
    "color": "#7aa2f7",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#2ac3de",
    "bold": true
  },
  "h3": {
    "prefix": "### ",
    "color": "#7dcfff",
    "bold": true
  },
  "h4": {
    "prefix": "#### ",
    "color": "#b4f9f8",
    "bold": true
  },
  "h5": {
    "prefix": "##### ",
    "color": "#9ece6a",
    "bold": true
  },
  "h6": {
    "prefix": "###### ",
    "color": "#e0af68",
    "bold": true
  },
  "text": {},
  "strong": {
    "bold": true,
    "color": "#ff9e64"
  },
  "emphasis": {
    "italic": true,
    "color": "#bb9af7"
  },
  "item": {
    "block_prefix": "• ",
    "color": "#7dcfff"
  },
  "enumeration": {
    "block_prefix": "%d. ",
    "color": "#7dcfff"
  },
  "code": {
    "color": "#7aa2f7",
    "background_color": "#1f2335"
  },
  "code_block": {
    "color": "#c0caf5",
    "chroma": {
      "text": {
        "color": "#c0caf5"
      },
      "error": {
        "color": "#f7768e",
        "background_color": "#1f2335"
      },
      "comment": {
        "color": "#565f89",
        "italic": true
      },
      "keyword": {
        "color": "#bb9af7",
        "bold": true
      },
      "keyword_type": {
        "color": "#2ac3de"
      },
      "operator": {
        "color": "#89ddff"
      },
      "punctuation": {
        "color": "#c0caf5"
      },
      "name": {
        "color": "#7aa2f7"
      },
      "name_builtin": {
        "color": "#2ac3de"
      },
      "name_function": {
        "color": "#7aa2f7"
      },
      "name_class": {
        "color": "#e0af68"
      },
      "name_constant": {
        "color": "#ff9e64"
      },
      "name_variable": {
        "color": "#c0caf5"
      },
      "literal_number": {
        "color": "#ff9e64"
      },
      "literal_string": {
        "color": "#9ece6a"
      },
      "literal_string_escape": {
        "color": "#b4f9f8"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n 🠶 "
  },
  "link": {
    "color": "#73daca",
    "underline": true
  },
  "link_text": {
    "color": "#7aa2f7",
    "bold": true
  }
}
