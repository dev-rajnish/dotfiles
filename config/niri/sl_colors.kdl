// =============================================================================
//  Shoelace Modular Colors (sl_colors.kdl)
// =============================================================================

layout {
    background-color "#1a1b26"

    border {
        active-color "#7aa2f7"
        inactive-color "#414868"
        urgent-color "#f7768e"
    }

    focus-ring {
        active-color "#7aa2f7"
        inactive-color "#414868"
        urgent-color "#f7768e"
    }

    shadow {
        color "#00000080"
    }

    tab-indicator {
        active-color "#7aa2f7"
        inactive-color "#414868"
        urgent-color "#f7768e"
    }

    insert-hint {
        color "#7aa2f780"
    }
}

overview {
    backdrop-color "#1a1b26e0"
}
