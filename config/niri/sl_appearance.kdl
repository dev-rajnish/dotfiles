// =============================================================================
//  Shoelace Modular Appearance (sl_appearance.kdl)
// =============================================================================

layout {
    struts {
        top -10
        bottom -20
        right -40
        left -40
    }
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true

    border {
        width 2
    }

    focus-ring {
        width 2
    }
}


window-rule {
    match is-focused=false
    opacity 0.75
    draw-border-with-background true

}

window-rule {
    match is-floating=true
    opacity 1.0
    draw-border-with-background false

    shadow {
        on
        softness 10
        spread 10
        offset x=0 y=12
    }

}

