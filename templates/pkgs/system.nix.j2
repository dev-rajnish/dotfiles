# =============================================================================
#  System-Wide Core Packages Module
#  Auto-generated from tokens/pkgs/system.toml via MiniJinja (bin/pkg-render)
# =============================================================================
{ pkgs, ... }: {
  environment.systemPackages = with pkgs; [
    {%- for p in system_pkgs.pkgs %}
    {{ p }}
    {%- endfor %}
  ];
}
