# =============================================================================
#  Fonts & Typography Module
#  Auto-generated from tokens/pkgs/fonts.toml via MiniJinja (bin/pkg-render)
# =============================================================================
{ pkgs, ... }: {
  fonts = {
    fontconfig.enable = true;
    fontDir.enable = true;
    packages = with pkgs; [
      {%- for p in font_pkgs.pkgs %}
      {{ p }}
      {%- endfor %}
    ];
  };
}
