# =============================================================================
#  MIME Applications List (Auto-generated by sl-render from tokens/apps.toml)
#  Location: ~/.config/mimeapps.list
# =============================================================================

[Default Applications]
{% if browser is defined and browser %}
text/html={{ browser }}.desktop
application/xhtml+xml={{ browser }}.desktop
x-scheme-handler/http={{ browser }}.desktop
x-scheme-handler/https={{ browser }}.desktop
x-scheme-handler/about={{ browser }}.desktop
x-scheme-handler/unknown={{ browser }}.desktop
x-scheme-handler/chrome={{ browser }}.desktop
{% endif %}

{% if editor is defined and editor %}
text/plain={{ editor }}.desktop
text/markdown={{ editor }}.desktop
text/x-markdown={{ editor }}.desktop
text/x-makefile={{ editor }}.desktop
text/x-c={{ editor }}.desktop
text/x-c++={{ editor }}.desktop
text/x-python={{ editor }}.desktop
text/x-rust={{ editor }}.desktop
text/x-nix={{ editor }}.desktop
application/json={{ editor }}.desktop
application/toml={{ editor }}.desktop
application/yaml={{ editor }}.desktop
application/xml={{ editor }}.desktop
application/x-shellscript={{ editor }}.desktop
{% endif %}

{% if pdfViewer is defined and pdfViewer %}
application/pdf={{ pdfViewer }}.desktop
application/x-pdf={{ pdfViewer }}.desktop
application/epub+zip={{ pdfViewer }}.desktop
{% endif %}

{% if fileManager is defined and fileManager %}
inode/directory={{ fileManager }}.desktop
application/zip={{ fileManager }}.desktop
application/x-tar={{ fileManager }}.desktop
application/x-7z-compressed={{ fileManager }}.desktop
application/x-rar={{ fileManager }}.desktop
application/gzip={{ fileManager }}.desktop
application/x-bzip2={{ fileManager }}.desktop
application/x-xz={{ fileManager }}.desktop
{% endif %}

{% if videoPlayer is defined and videoPlayer %}
video/mp4={{ videoPlayer }}.desktop
video/mkv={{ videoPlayer }}.desktop
video/webm={{ videoPlayer }}.desktop
video/x-matroska={{ videoPlayer }}.desktop
video/quicktime={{ videoPlayer }}.desktop
{% endif %}

{% if audioPlayer is defined and audioPlayer %}
audio/mpeg={{ audioPlayer }}.desktop
audio/mp3={{ audioPlayer }}.desktop
audio/flac={{ audioPlayer }}.desktop
audio/wav={{ audioPlayer }}.desktop
audio/ogg={{ audioPlayer }}.desktop
audio/opus={{ audioPlayer }}.desktop
{% endif %}

{% if imageViewer is defined and imageViewer %}
image/jpeg={{ imageViewer }}.desktop
image/png={{ imageViewer }}.desktop
image/gif={{ imageViewer }}.desktop
image/webp={{ imageViewer }}.desktop
image/svg+xml={{ imageViewer }}.desktop
image/bmp={{ imageViewer }}.desktop
image/avif={{ imageViewer }}.desktop
image/jxl={{ imageViewer }}.desktop
{% endif %}

[Added Associations]
{% if browser is defined and browser %}
text/html={{ browser }}.desktop;
x-scheme-handler/http={{ browser }}.desktop;
x-scheme-handler/https={{ browser }}.desktop;
{% endif %}
