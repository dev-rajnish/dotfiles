// =============================================================================
//  Shoelace Modular Keybindings (sl_keybinds.kdl)
// =============================================================================

binds {
    // System & Session Binds
{% for b in system_binds %}
    {{ b.key }}{% if b.allow_inhibiting_false %} allow-inhibiting=false{% endif %}{% if b.allow_when_locked %} allow-when-locked=true{% endif %}{% if b.repeat_false %} repeat=false{% endif %}{% if b.title %} hotkey-overlay-title="{{ b.title }}"{% endif %} { {{ b.action }}; }
{% endfor %}

    // Application Launchers
{% for b in app_binds %}
    {%- if b.app == "browser" %}
        {%- set action = 'spawn "' ~ browser ~ '"' %}
        {%- set default_title = "Web Browser: " ~ browser %}
    {%- elif b.app == "terminal" %}
        {%- set action = 'spawn "' ~ terminal ~ '"' %}
        {%- set default_title = "Terminal: " ~ terminal %}
    {%- elif b.app == "fileManager" %}
        {%- set action = 'spawn "' ~ fileManager ~ '"' %}
        {%- set default_title = "File Manager: " ~ fileManager %}
    {%- elif b.app == "editor" %}
        {%- set action = 'spawn "' ~ editor ~ '"' %}
        {%- set default_title = "Editor: " ~ editor %}
    {%- else %}
        {%- set action = b.action %}
        {%- set default_title = b.title %}
    {%- endif %}
    {%- set title = b.title or default_title %}
    {{ b.key }}{% if b.repeat_false %} repeat=false{% endif %}{% if title %} hotkey-overlay-title="{{ title }}"{% endif %} { {{ action }}; }
{% endfor %}

    // Hardware & Media Keys
{% for b in media_binds %}
    {{ b.key }} allow-when-locked=true { {{ b.action }}; }
{% endfor %}

    // Window Management & Actions
{% for b in window_binds %}
    {{ b.key }}{% if b.repeat_false %} repeat=false{% endif %} { {{ b.action }}; }
{% endfor %}

    // Focus Navigation
{% for b in nav_binds %}
    {{ b.key }} { {{ b.action }}; }
{% endfor %}

    // Move Columns & Windows
{% for b in move_binds %}
    {{ b.key }} { {{ b.action }}; }
{% endfor %}

    // Sizing & Presets
{% for b in sizing_binds %}
    {{ b.key }} { {{ b.action }}; }
{% endfor %}

    // Workspaces
{% for b in workspace_binds %}
    {{ b.key }} { {{ b.action }}; }
{% endfor %}
}
