# =============================================================================
#  Labwc Environment & Session Variables
#  Mirrors Niri env.kdl Configuration
# =============================================================================

# Wayland & Toolkit Display Setup
GDK_BACKEND=wayland
QT_QPA_PLATFORM=wayland
ELECTRON_OZONE_PLATFORM_HINT=auto

# Mozilla / Firefox Wayland Integration
MOZ_ENABLE_WAYLAND=1

# Qt Platform Themes (qt5ct / qt6ct)
QT_QPA_PLATFORMTHEME=qt6ct
QT_QPA_PLATFORMTHEME_QT6=qt6ct

# Cursors & XKB Defaults (from 2-xdg-config-vars.nix)
XCURSOR_THEME=Bibata-Modern-Ice
XCURSOR_SIZE=32
XKB_DEFAULT_LAYOUT=us

# Custom Session Identifiers
LABWC_ENV=modular
