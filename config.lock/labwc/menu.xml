<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     Labwc Context & Root Menu Definition
     ============================================================================= -->
<openbox_menu>
  <menu id="root-menu" label="Applications">
    <!-- Quick Launchers -->
    <item label="Kitty Terminal" icon="utilities-terminal">
      <action name="Execute" command="kitty" />
    </item>
    <item label="LibreWolf Browser" icon="web-browser">
      <action name="Execute" command="librewolf" />
    </item>
    <item label="Thunar File Manager" icon="system-file-manager">
      <action name="Execute" command="thunar" />
    </item>
    <item label="Application Launcher (Fuzzel)" icon="system-search">
      <action name="Execute" command="fuzzel" />
    </item>

    <separator />

    <!-- Utilities -->
    <item label="Wallpaper Selector (Waypaper)" icon="preferences-desktop-wallpaper">
      <action name="Execute" command="wallpaper --gui" />
    </item>
    <item label="Clipboard History" icon="edit-paste">
      <action name="Execute" command="sh -c 'cliphist list | fuzzel -d | cliphist decode | wl-copy'" />
    </item>
    <item label="Toggle Status Bar (Wayle)" icon="view-refresh">
      <action name="Execute" command="sh -c 'wayle panel toggle || wayle shell'" />
    </item>

    <separator />

    <!-- Session Management -->
    <item label="Lock Screen" icon="system-lock-screen">
      <action name="Execute" command="swaylock" />
    </item>
    <item label="Power &amp; Session Menu" icon="system-shutdown">
      <action name="Execute" command="power-menu" />
    </item>
    <item label="Reload Labwc Configuration" icon="view-refresh">
      <action name="Reconfigure" />
    </item>
    <item label="Exit Labwc" icon="system-log-out">
      <action name="Exit" />
    </item>
  </menu>
</openbox_menu>
