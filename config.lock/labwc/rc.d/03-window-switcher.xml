<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     03-WINDOW-SWITCHER-OSD.XML
     Alt-Tab Window Switcher HUD, Previews, Outlines & Ordering
     Reference: man labwc-config(5) -> WINDOW SWITCHER
     ============================================================================= -->
<!-- Attributes:
     - preview: [yes | no] Show live window contents in switcher OSD. Default: yes
     - outlines: [yes | no] Draw bounding box outlines on selected window. Default: yes
     - unshade: [yes | no] Temporarily unshade rolled-up window on selection. Default: yes
     - order: [mru | index] Window list ordering (mru = Most Recently Used, index = Creation Order). Default: mru -->
<windowSwitcher preview="yes" outlines="yes" unshade="yes" order="mru">
  <!-- On-Screen Display (OSD) Configuration
       - show: [yes | no] Display HUD overlay during Alt-Tab switching.
       - style: [thumbnail | classic] Render graphical window thumbnails or traditional list.
       - thumbnailLabelFormat: String template for titles (%t = Window Title, %c = App Class). -->
  <osd show="yes" style="thumbnail" thumbnailLabelFormat="%t" />

  <!-- Layout Fields in Switcher UI -->
  <fields>
    <field content="icon" width="20%" />
    <field content="title" width="80%" />
  </fields>
</windowSwitcher>
