<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     14-TOUCH-AND-TABLET.XML
     Touchscreen Display Mapping, Graphics Tablet Tools & Stylus Calibration
     Reference: man labwc-config(5) -> TOUCH & TABLET
     ============================================================================= -->
<touch_and_tablet_config>
  <!-- =========================================================================
       1. Touchscreens
       ========================================================================= -->
  <!-- Attributes:
       - deviceName: Specific input hardware device name (empty = all touch devices).
       - mapToOutput: Output connector name to lock touch coordinates to (e.g. eDP-1).
       - mouseEmulation: [yes | no] Emulate mouse clicks on touch events. Default: no -->
  <touch deviceName="" mapToOutput="" mouseEmulation="no" />

  <!-- =========================================================================
       2. Drawing & Graphics Tablets (Wacom / XP-Pen / Huion)
       ========================================================================= -->
  <!-- Attributes:
       - mapToOutput: Screen display to bind stylus coordinates to.
       - rotate: [0 | 90 | 180 | 270] Stylus orientation rotation.
       - mouseEmulation: [yes | no] Map tablet events to standard pointer clicks. -->
  <tablet mapToOutput="" rotate="0" mouseEmulation="no">
    <!-- Active Surface Area Truncation (in millimeters)
         Example: <area top="0.0" left="0.0" width="215.0" height="135.0" /> -->
    <area top="0.0" left="0.0" width="0.0" height="0.0" />

    <!-- Stylus Hardware Button Bindings -->
    <map button="Tip" to="Left" />
    <map button="Stylus" to="Right" />
    <map button="Stylus2" to="Middle" />
  </tablet>

  <!-- Tablet Tool Motion Profile [absolute | relative] -->
  <tabletTool motion="absolute" relativeMotionSensitivity="1.0" />
</touch_and_tablet_config>
