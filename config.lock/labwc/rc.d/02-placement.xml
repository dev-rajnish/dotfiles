<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     02-WINDOW-PLACEMENT.XML
     New Window Positioning Policy & Cascade Geometry
     Reference: man labwc-config(5) -> PLACEMENT
     ============================================================================= -->
<placement>
  <!-- Placement Policy [center | automatic | cursor | cascade]
       Determines where new unmapped application windows appear on screen:
       - cascade: Offsets each new window relative to previous ones (default).
       - center: Positions new windows in the center of the active display.
       - automatic: Intelligently places windows in available empty screen space.
       - cursor: Places new windows centered underneath the active mouse cursor. -->
  <policy>cascade</policy>

  <!-- Cascade Offset (in pixels)
       Horizontal (x) and vertical (y) step distance between successive cascaded windows. -->
  <cascadeOffset>
    <x>32</x>
    <y>32</y>
  </cascadeOffset>
</placement>
