<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     18-MAGNIFIER-UTILITY.XML
     Screen Magnifier Overlay Geometry, Zoom Increments & Filtering
     Reference: man labwc-config(5) -> MAGNIFIER & man labwc-actions(5) (ToggleMagnifier)
     ============================================================================= -->
<magnifier>
  <!-- Magnifier Lens Dimensions (in pixels) -->
  <width>400</width>
  <height>400</height>

  <!-- Initial Zoom Scale Factor (e.g. 2.0 = 200% magnification) -->
  <initScale>2.0</initScale>

  <!-- Zoom Scale Step Increment -->
  <increment>0.2</increment>

  <!-- Bilinear Texture Filter Interpolation [yes | no | default]
       - yes: Smooth bilinear interpolation.
       - no: Pixelated nearest-neighbor rendering (crisp text/pixel art). -->
  <useFilter>true</useFilter>
</magnifier>
