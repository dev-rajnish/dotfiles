<!-- Output Margin Reservations (in pixels)
     Defines empty space at display borders that windows will not occlude.
     Layer-shell panels (Wayle, Waybar) reserve this automatically via exclusive zones.
     Manual margins can be defined per-output or globally:
     Example: <margin top="32" bottom="0" left="0" right="0" output="*" /> -->
<margin top="0" bottom="0" left="0" right="0" />
