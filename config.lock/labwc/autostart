#!/usr/bin/env bash
# =============================================================================
#  Labwc Wayland Compositor Autostart Script
#  Mirrors Niri Startup Configuration
# =============================================================================

# 1. Set display scaling to 1.10 (110%)
if command -v wlr-randr >/dev/null 2>&1; then
    wlr-randr --output eDP-1 --scale 1.10 &
fi

# 2. Restore active wallpaper via native wallpaper binary
if command -v wallpaper >/dev/null 2>&1; then
    wallpaper --restore &
fi

# 3. Set display brightness
if command -v brightnessctl >/dev/null 2>&1; then
    brightnessctl s 80% &
fi

# 4. Launch or restart Wayle status bar panel
if command -v wayle >/dev/null 2>&1; then
    wayle panel restart &
fi
