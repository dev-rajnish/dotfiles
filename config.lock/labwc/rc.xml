<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     Labwc Main Configuration (rc.xml)
     A Modular, Wayland Stacking Compositor Configuration
     Reference: man labwc(1), man labwc-config(5), man labwc-actions(5),
                man labwc-theme(5), man labwc-menu(5)
     
     Modular source files reside in ~/.config/labwc/rc.d/:
       - 01-core.xml
       - 02-placement.xml
       - 03-window-switcher.xml
       - 04-resistance.xml
       - 05-focus.xml
       - 06-snapping.xml
       - 07-regions.xml
       - 08-workspaces-and-desktops.xml
       - 09-theme-and-typography.xml
       - 10-margin.xml
       - 11-resize.xml
       - 12-keyboard-and-keybinds.xml
       - 13-mouse-and-actions.xml
       - 14-touch-and-tablet.xml
       - 15-libinput-and-gestures.xml
       - 16-window-rules.xml
       - 17-menu-behavior.xml
       - 18-magnifier.xml
     ============================================================================= -->
<labwc_config>

  <!-- =========================================================================
       01. Core Engine & Rendering Options (01-core.xml)
       ========================================================================= -->
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
    <allowTearing>no</allowTearing>
    <autoEnableOutputs>yes</autoEnableOutputs>
    <reuseOutputMode>yes</reuseOutputMode>
    <xwaylandPersistence>no</xwaylandPersistence>
    <primarySelection>yes</primarySelection>
    <promptCommand>fuzzel</promptCommand>
  </core>

  <!-- =========================================================================
       02. Window Placement Policy (02-placement.xml)
       ========================================================================= -->
  <placement>
    <policy>cascade</policy>
    <cascadeOffset>
      <x>32</x>
      <y>32</y>
    </cascadeOffset>
  </placement>

  <!-- =========================================================================
       03. Alt-Tab Window Switcher HUD & OSD (03-window-switcher.xml)
       ========================================================================= -->
  <windowSwitcher preview="yes" outlines="yes" unshade="yes" order="mru">
    <osd show="yes" style="thumbnail" thumbnailLabelFormat="%t" />
    <fields>
      <field content="icon" width="20%" />
      <field content="title" width="80%" />
    </fields>
  </windowSwitcher>

  <!-- =========================================================================
       04. Edge Snapping & Drag Resistance (04-resistance.xml)
       ========================================================================= -->
  <resistance>
    <screenEdgeStrength>20</screenEdgeStrength>
    <windowEdgeStrength>10</windowEdgeStrength>
    <unSnapThreshold>30</unSnapThreshold>
    <unMaximizeThreshold>40</unMaximizeThreshold>
  </resistance>

  <!-- =========================================================================
       05. Window Focus Behavior (05-focus.xml)
       ========================================================================= -->
  <focus>
    <followMouse>no</followMouse>
    <followMouseRequiresMovement>yes</followMouseRequiresMovement>
    <raiseOnFocus>yes</raiseOnFocus>
  </focus>

  <!-- =========================================================================
       06. Window Edge & Corner Snapping (06-snapping.xml)
       ========================================================================= -->
  <snapping>
    <range>
      <inner>10</inner>
      <outer>15</outer>
    </range>
    <cornerRange>20</cornerRange>
    <topMaximize>yes</topMaximize>
    <notifyClient>region</notifyClient>
    <overlay>
      <enabled>yes</enabled>
      <delay>
        <inner>100</inner>
        <outer>100</outer>
      </delay>
    </overlay>
  </snapping>

  <!-- =========================================================================
       07. Tiling & Grid Snap Regions (07-regions.xml)
       ========================================================================= -->
  <regions>
    <region name="left" x="0%" y="0%" width="50%" height="100%" />
    <region name="right" x="50%" y="0%" width="50%" height="100%" />
    <region name="top" x="0%" y="0%" width="100%" height="50%" />
    <region name="bottom" x="0%" y="50%" width="100%" height="50%" />
    <region name="top-left" x="0%" y="0%" width="50%" height="50%" />
    <region name="top-right" x="50%" y="0%" width="50%" height="50%" />
    <region name="bottom-left" x="0%" y="50%" width="50%" height="50%" />
    <region name="bottom-right" x="50%" y="50%" width="50%" height="50%" />
    <region name="center" x="20%" y="0%" width="60%" height="100%" />
  </regions>

  <!-- =========================================================================
       08. Virtual Workspaces / Desktops (08-workspaces-and-desktops.xml)
       ========================================================================= -->
  <desktops number="9">
    <names>
      <name>browser</name>
      <name>terminal</name>
      <name>editor</name>
      <name>4</name>
      <name>5</name>
      <name>6</name>
      <name>7</name>
      <name>8</name>
      <name>9</name>
    </names>
    <initial>1</initial>
    <popupTime>0</popupTime>
    <prefix>Workspace </prefix>
  </desktops>

  <!-- =========================================================================
       09. Theme, Titlebar Layout & Typography (09-theme-and-typography.xml)
       ========================================================================= -->
  <theme>
    <name>macos</name>
    <icon>Papirus-Dark</icon>
    <fallbackAppIcon>application-x-executable</fallbackAppIcon>
    <cornerRadius>8</cornerRadius>
    <keepBorder>yes</keepBorder>
    <maximizedDecoration>none</maximizedDecoration>
    <dropShadows>yes</dropShadows>
    <dropShadowsOnTiled>no</dropShadowsOnTiled>
    <titlebar>
      <layout>close,iconify,max:</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <font place="ActiveWindow">
      <name>JetBrainsMono Nerd Font</name>
      <size>11</size>
      <weight>bold</weight>
    </font>
    <font place="InactiveWindow">
      <name>JetBrainsMono Nerd Font</name>
      <size>11</size>
      <weight>normal</weight>
    </font>
    <font place="MenuItem">
      <name>JetBrainsMono Nerd Font</name>
      <size>11</size>
    </font>
    <font place="OnScreenDisplay">
      <name>JetBrainsMono Nerd Font</name>
      <size>12</size>
      <weight>bold</weight>
    </font>
  </theme>

  <!-- =========================================================================
       10. Screen Edge Margins (10-margin.xml)
       ========================================================================= -->
  <margin top="0" bottom="0" left="0" right="0" />

  <!-- =========================================================================
       11. Window Resize Geometry (11-resize.xml)
       ========================================================================= -->
  <resize>
    <popupShow>Never</popupShow>
    <drawContents>yes</drawContents>
    <cornerRange>10</cornerRange>
    <minimumArea>100x100</minimumArea>
  </resize>

  <!-- =========================================================================
       12. Keyboard & Keybindings (12-keyboard-and-keybinds.xml)
       ========================================================================= -->
  <keyboard>
    <numlock>on</numlock>
    <layoutScope>global</layoutScope>
    <repeatDelay>300</repeatDelay>
    <repeatRate>30</repeatRate>

    <!-- 12.1 System & Session Controls -->
    <keybind key="W-S-e">
      <action name="Execute" command="power-menu.sh" />
    </keybind>
    <keybind key="C-A-Delete">
      <action name="Execute" command="power-menu.sh" />
    </keybind>
    <keybind key="W-S-p">
      <action name="Execute" command="sh -c 'wlopm --off * || niri msg action power-off-monitors || hyprctl dispatch dpms off || swaymsg &quot;output * dpms off&quot;'" />
    </keybind>
    <keybind key="W-Escape">
      <action name="ToggleKeybinds" />
    </keybind>
    <keybind key="W-slash">
      <action name="ShowMenu" menu="root-menu" />
    </keybind>
    <keybind key="W-C-q">
      <action name="Exit" />
    </keybind>
    <keybind key="W-C-BackSpace">
      <action name="Reconfigure" />
    </keybind>

    <!-- 12.2 Application Launchers & Utilities -->
    <keybind key="W-Return">
      <action name="Execute" command="kitty" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="thunar" />
    </keybind>
    <keybind key="W-a">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="W-b">
      <action name="Execute" command="librewolf" />
    </keybind>
    <keybind key="W-A-l">
      <action name="Execute" command="swaylock" />
    </keybind>
    <keybind key="W-n">
      <action name="Execute" command="sh -c 'wayle panel toggle || wayle shell'" />
    </keybind>
    <keybind key="W-c">
      <action name="Execute" command="clipboard.sh" />
    </keybind>
    <keybind key="W-S-w">
      <action name="Execute" command="wallpaper.lua --gui" />
    </keybind>

    <!-- 12.3 Window Management -->
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="W-f">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-S-f">
      <action name="ToggleFullscreen" />
    </keybind>
    <keybind key="W-S-space">
      <action name="ToggleAlwaysOnTop" />
    </keybind>
    <keybind key="W-h">
      <action name="Iconify" />
    </keybind>
    <keybind key="W-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>

    <!-- 12.4 Directional Focus -->
    <keybind key="W-Left">
      <action name="DirectionalFocus" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="DirectionalFocus" direction="right" />
    </keybind>
    <keybind key="W-Up">
      <action name="DirectionalFocus" direction="up" />
    </keybind>
    <keybind key="W-Down">
      <action name="DirectionalFocus" direction="down" />
    </keybind>
    <keybind key="W-j">
      <action name="DirectionalFocus" direction="down" />
    </keybind>
    <keybind key="W-k">
      <action name="DirectionalFocus" direction="up" />
    </keybind>

    <!-- 12.5 Window Shifting & Moving -->
    <keybind key="W-S-Left">
      <action name="MoveRelative" x="-40" y="0" />
    </keybind>
    <keybind key="W-S-Right">
      <action name="MoveRelative" x="40" y="0" />
    </keybind>
    <keybind key="W-S-Up">
      <action name="MoveRelative" x="0" y="-40" />
    </keybind>
    <keybind key="W-S-Down">
      <action name="MoveRelative" x="0" y="40" />
    </keybind>
    <keybind key="W-S-j">
      <action name="MoveRelative" x="0" y="40" />
    </keybind>
    <keybind key="W-S-k">
      <action name="MoveRelative" x="0" y="-40" />
    </keybind>

    <!-- 12.6 Window Resizing -->
    <keybind key="W-C-Left">
      <action name="ResizeRelative" left="-40" right="0" top="0" bottom="0" />
    </keybind>
    <keybind key="W-C-Right">
      <action name="ResizeRelative" left="0" right="40" top="0" bottom="0" />
    </keybind>
    <keybind key="W-C-Up">
      <action name="ResizeRelative" left="0" right="0" top="-40" bottom="0" />
    </keybind>
    <keybind key="W-C-Down">
      <action name="ResizeRelative" left="0" right="0" top="0" bottom="40" />
    </keybind>
    <keybind key="W-C-h">
      <action name="ResizeRelative" left="-40" right="0" top="0" bottom="0" />
    </keybind>
    <keybind key="W-C-l">
      <action name="ResizeRelative" left="0" right="40" top="0" bottom="0" />
    </keybind>
    <keybind key="W-C-j">
      <action name="ResizeRelative" left="0" right="0" top="0" bottom="40" />
    </keybind>
    <keybind key="W-C-k">
      <action name="ResizeRelative" left="0" right="0" top="-40" bottom="0" />
    </keybind>

    <!-- 12.7 Workspace Navigation -->
    <keybind key="W-i">
      <action name="GoToDesktop" to="right" />
    </keybind>
    <keybind key="W-u">
      <action name="GoToDesktop" to="left" />
    </keybind>
    <keybind key="W-S-u">
      <action name="SendToDesktop" to="left" follow="yes" />
    </keybind>
    <keybind key="W-S-i">
      <action name="SendToDesktop" to="right" follow="yes" />
    </keybind>
    <keybind key="W-C-i">
      <action name="GoToDesktop" to="right" />
    </keybind>
    <keybind key="W-C-u">
      <action name="GoToDesktop" to="left" />
    </keybind>

    <!-- Direct Workspace Switching (1 - 9) -->
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-5"><action name="GoToDesktop" to="5" /></keybind>
    <keybind key="W-6"><action name="GoToDesktop" to="6" /></keybind>
    <keybind key="W-7"><action name="GoToDesktop" to="7" /></keybind>
    <keybind key="W-8"><action name="GoToDesktop" to="8" /></keybind>
    <keybind key="W-9"><action name="GoToDesktop" to="9" /></keybind>

    <!-- Direct Window Send to Workspace (1 - 9) -->
    <keybind key="W-C-1"><action name="SendToDesktop" to="1" follow="no" /></keybind>
    <keybind key="W-C-2"><action name="SendToDesktop" to="2" follow="no" /></keybind>
    <keybind key="W-C-3"><action name="SendToDesktop" to="3" follow="no" /></keybind>
    <keybind key="W-C-4"><action name="SendToDesktop" to="4" follow="no" /></keybind>
    <keybind key="W-C-5"><action name="SendToDesktop" to="5" follow="no" /></keybind>
    <keybind key="W-C-6"><action name="SendToDesktop" to="6" follow="no" /></keybind>
    <keybind key="W-C-7"><action name="SendToDesktop" to="7" follow="no" /></keybind>
    <keybind key="W-C-8"><action name="SendToDesktop" to="8" follow="no" /></keybind>
    <keybind key="W-C-9"><action name="SendToDesktop" to="9" follow="no" /></keybind>

    <!-- 12.8 Tiling & Directional Snapping -->
    <keybind key="W-A-Left">
      <action name="SnapToRegion" region="left" />
    </keybind>
    <keybind key="W-A-Right">
      <action name="SnapToRegion" region="right" />
    </keybind>
    <keybind key="W-A-Up">
      <action name="SnapToRegion" region="top" />
    </keybind>
    <keybind key="W-A-Down">
      <action name="SnapToRegion" region="bottom" />
    </keybind>
    <keybind key="W-A-Home">
      <action name="SnapToRegion" region="top-left" />
    </keybind>
    <keybind key="W-A-Prior">
      <action name="SnapToRegion" region="top-right" />
    </keybind>
    <keybind key="W-A-End">
      <action name="SnapToRegion" region="bottom-left" />
    </keybind>
    <keybind key="W-A-Next">
      <action name="SnapToRegion" region="bottom-right" />
    </keybind>

    <!-- 12.9 Audio, Brightness & Media -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="XF86AudioMicMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl s 5%+" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl s 5%-" />
    </keybind>
    <keybind key="XF86AudioPlay">
      <action name="Execute" command="playerctl play-pause" />
    </keybind>
    <keybind key="XF86AudioPause">
      <action name="Execute" command="playerctl pause" />
    </keybind>
    <keybind key="XF86AudioNext">
      <action name="Execute" command="playerctl next" />
    </keybind>
    <keybind key="XF86AudioPrev">
      <action name="Execute" command="playerctl previous" />
    </keybind>
    <keybind key="XF86AudioStop">
      <action name="Execute" command="playerctl stop" />
    </keybind>

    <!-- 12.10 Screenshots -->
    <keybind key="Print">
      <action name="Execute" command="sh -c 'mkdir -p ~/Pictures/Screenshots &amp;&amp; grim ~/Pictures/Screenshots/screenshot_$(date +%Y-%m-%d_%H-%M-%S).png'" />
    </keybind>
    <keybind key="W-p">
      <action name="Execute" command="sh -c 'mkdir -p ~/Pictures/Screenshots &amp;&amp; grim ~/Pictures/Screenshots/screenshot_$(date +%Y-%m-%d_%H-%M-%S).png'" />
    </keybind>
    <keybind key="A-p">
      <action name="Execute" command="sh -c 'mkdir -p ~/Pictures/Screenshots &amp;&amp; grim -g &quot;$(slurp)&quot; ~/Pictures/Screenshots/screenshot_$(date +%Y-%m-%d_%H-%M-%S).png'" />
    </keybind>
  </keyboard>

  <!-- =========================================================================
       13. Mouse Actions & Context Interactions (13-mouse-and-actions.xml)
       ========================================================================= -->
  <mouse>
    <doubleClickTime>500</doubleClickTime>
    <default />
    <context name="Frame">
      <mousebind button="W-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="W-Right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="Title">
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" />
      </mousebind>
      <mousebind button="Middle" action="Click">
        <action name="Lower" />
      </mousebind>
      <mousebind direction="Up" action="Scroll">
        <action name="Shade" />
      </mousebind>
      <mousebind direction="Down" action="Scroll">
        <action name="Unshade" />
      </mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="ShowMenu" menu="client-list-combined-menu" />
      </mousebind>
      <mousebind direction="W-Up" action="Scroll">
        <action name="GoToDesktop" to="left" />
      </mousebind>
      <mousebind direction="W-Down" action="Scroll">
        <action name="GoToDesktop" to="right" />
      </mousebind>
    </context>
  </mouse>

  <!-- =========================================================================
       14. Touch & Graphics Tablet Configuration (14-touch-and-tablet.xml)
       ========================================================================= -->
  <touch deviceName="" mapToOutput="" mouseEmulation="no" />
  <tablet mapToOutput="" rotate="0" mouseEmulation="no">
    <area top="0.0" left="0.0" width="0.0" height="0.0" />
    <map button="Tip" to="Left" />
    <map button="Stylus" to="Right" />
    <map button="Stylus2" to="Middle" />
  </tablet>
  <tabletTool motion="absolute" relativeMotionSensitivity="1.0" />

  <!-- =========================================================================
       15. Libinput Hardware Profiles & Gestures (15-libinput-and-gestures.xml)
       ========================================================================= -->
  <libinput>
    <device category="touchpad">
      <naturalScroll>no</naturalScroll>
      <pointerSpeed>0.6</pointerSpeed>
      <scrollFactor>0.3</scrollFactor>
      <accelProfile>adaptive</accelProfile>
      <tap>yes</tap>
      <tapAndDrag>yes</tapAndDrag>
      <dragLock>no</dragLock>
      <threeFingerDrag>3</threeFingerDrag>
      <tapButtonMap>lrm</tapButtonMap>
      <clickMethod>clickfinger</clickMethod>
      <scrollMethod>twofinger</scrollMethod>
      <disableWhileTyping>yes</disableWhileTyping>
      <middleEmulation>yes</middleEmulation>
    </device>
    <device category="non-touch">
      <naturalScroll>yes</naturalScroll>
      <middleEmulation>yes</middleEmulation>
    </device>
  </libinput>

  <!-- =========================================================================
       16. Application Window Rules & Workspaces (16-window-rules.xml)
       ========================================================================= -->
  <windowRules>
    <!-- Floating Dialogs & Utilities -->
    <windowRule identifier="*firefox*" title="*Picture-in-Picture*">
      <action name="None" />
    </windowRule>
    <windowRule identifier="*waypaper*" title="*Waypaper*">
      <action name="None" />
    </windowRule>
    <windowRule title="*Volume Control*">
      <action name="None" />
    </windowRule>

    <!-- Workspace 1: Web Browsers -> "browser" -->
    <windowRule identifier="*firefox*">
      <action name="SendToDesktop" to="browser" follow="yes" />
    </windowRule>
    <windowRule identifier="*org.mozilla.firefox*">
      <action name="SendToDesktop" to="browser" follow="yes" />
    </windowRule>
    <windowRule identifier="*librewolf*">
      <action name="SendToDesktop" to="browser" follow="yes" />
    </windowRule>
    <windowRule identifier="*zen*">
      <action name="SendToDesktop" to="browser" follow="yes" />
    </windowRule>
    <windowRule identifier="*zen-beta*">
      <action name="SendToDesktop" to="browser" follow="yes" />
    </windowRule>
    <windowRule identifier="*zen-browser*">
      <action name="SendToDesktop" to="browser" follow="yes" />
    </windowRule>
    <windowRule identifier="*qutebrowser*">
      <action name="SendToDesktop" to="browser" follow="yes" />
    </windowRule>
    <windowRule identifier="*org.qutebrowser.qutebrowser*">
      <action name="SendToDesktop" to="browser" follow="yes" />
    </windowRule>
    <windowRule identifier="*google-chrome*">
      <action name="SendToDesktop" to="browser" follow="yes" />
    </windowRule>
    <windowRule identifier="*chromium*">
      <action name="SendToDesktop" to="browser" follow="yes" />
    </windowRule>
    <windowRule identifier="*brave-browser*">
      <action name="SendToDesktop" to="browser" follow="yes" />
    </windowRule>
    <windowRule identifier="*tor-browser*">
      <action name="SendToDesktop" to="browser" follow="yes" />
    </windowRule>

    <!-- Workspace 2: Terminal -> "terminal" -->
    <windowRule identifier="kitty">
      <action name="SendToDesktop" to="terminal" follow="yes" />
    </windowRule>

    <!-- Workspace 3: Editor -> "editor" -->
    <windowRule identifier="*nvim*">
      <action name="SendToDesktop" to="editor" follow="yes" />
    </windowRule>
    <windowRule identifier="*neovim*">
      <action name="SendToDesktop" to="editor" follow="yes" />
    </windowRule>
    <windowRule identifier="*neovide*">
      <action name="SendToDesktop" to="editor" follow="yes" />
    </windowRule>
    <windowRule title="*nvim*">
      <action name="SendToDesktop" to="editor" follow="yes" />
    </windowRule>
  </windowRules>

  <!-- =========================================================================
       17. Menu Behavior & Timing (17-menu-behavior.xml)
       ========================================================================= -->
  <menu>
    <ignoreButtonReleasePeriod>250</ignoreButtonReleasePeriod>
    <showIcons>yes</showIcons>
  </menu>

  <!-- =========================================================================
       18. Screen Magnifier Utility (18-magnifier.xml)
       ========================================================================= -->
  <magnifier>
    <width>400</width>
    <height>400</height>
    <initScale>2.0</initScale>
    <increment>0.2</increment>
    <useFilter>true</useFilter>
  </magnifier>

</labwc_config>
