# =============================================================================
#  Wallust Generated Labwc Appearance & Theme Override
# =============================================================================

# Border & Frame Geometry
border.width: 1
window.active.border.color: #C4A7E7
window.inactive.border.color: #050508

# Titlebar Layout & Colors
window.titlebar.padding.width: 10
window.titlebar.padding.height: 3
window.active.title.bg: Solid
window.active.title.bg.color: #191724
window.inactive.title.bg: Solid
window.inactive.title.bg.color: #050508

window.active.label.text.color: #E0DEF4
window.inactive.label.text.color: #3B3E52
window.label.text.justify: Center

# Titlebar Button Styling (macOS Circular Traffic Lights)
window.button.width: 14
window.button.height: 14
window.button.spacing: 8
window.button.hover.bg.color: #313244
window.button.hover.bg.corner-radius: 7

# Active macOS Traffic Light Colors
window.active.button.close.unpressed.image.color: #FF5F56
window.active.button.iconify.unpressed.image.color: #FFBD2E
window.active.button.max.unpressed.image.color: #27C93F

# Inactive Window Button Colors
window.inactive.button.close.unpressed.image.color: #14141E
window.inactive.button.iconify.unpressed.image.color: #14141E
window.inactive.button.max.unpressed.image.color: #14141E

# Window Drop Shadows
window.active.shadow.size: 20
window.inactive.shadow.size: 0
window.active.shadow.color: #000000C0
window.inactive.shadow.color: #00000000

# Window Snapping Edge & Region Overlay
snapping.overlay.edge.bg.color: #C4A7E733
snapping.overlay.edge.border.color: #C4A7E7
snapping.overlay.edge.border.width: 1
snapping.overlay.region.bg.color: #C4A7E733
snapping.overlay.region.border.color: #C4A7E7
snapping.overlay.region.border.width: 1

# On-Screen Display (OSD)
osd.bg.color: #191724E0
osd.border.color: #C4A7E7
osd.border.width: 1
osd.label.text.color: #E0DEF4

# Context & Root Menus
menu.border.width: 1
menu.border.color: #C4A7E7
menu.items.bg.color: #191724
menu.items.text.color: #E0DEF4
menu.items.active.bg.color: #C4A7E7
menu.items.active.text.color: #191724
