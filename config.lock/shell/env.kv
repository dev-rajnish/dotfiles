# =============================================================================
#  Shell Environment Variables (env.kv)
# =============================================================================

# Default Editors
EDITOR = nvim
VISUAL = nvim

# Modern CLI Utility Settings
BAT_THEME = ansi

# Pfetch Minimalist Customization (Custom Anime ASCII & Tokyo Night Theme)
PF_INFO = ascii title os host kernel uptime pkgs memory wm shell palette
PF_CUSTOM_ASCII = ~/.config/pfetch/ascii.txt
PF_COL1 = 4
PF_COL2 = 6
PF_COL3 = 5
PF_SEP = " 󰄾 "

# Fastboot & Device Variables
FASTBOOT = fastboot -S 32K
