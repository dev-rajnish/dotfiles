// =============================================================================
//  Shoelace Modular Colors (sl_colors.kdl)
// =============================================================================

layout {
    background-color "#1e1e2e"

    border {
        active-color "#89b4fa"
        inactive-color "#6c7086"
        urgent-color "#f38ba8"
    }

    focus-ring {
        active-color "#89b4fa"
        inactive-color "#6c7086"
        urgent-color "#f38ba8"
    }

    shadow {
        color "#00000080"
    }

    tab-indicator {
        active-color "#89b4fa"
        inactive-color "#6c7086"
        urgent-color "#f38ba8"
    }

    insert-hint {
        color "#89b4fa80"
    }
}

overview {
    backdrop-color "#1e1e2ee0"
}
