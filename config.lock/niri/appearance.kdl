// =============================================================================
//  Appearance & Window Decoration Overrides
// =============================================================================

window-rule {
    border {
        width 1
    }

    focus-ring {
        width 1
    }

    // geometry-corner-radius 0
    // clip-to-geometry true
    // draw-border-with-background false
}

// 🌑 Inactive Windows
window-rule {
    match is-focused=false
    opacity 0.75
    draw-border-with-background true
}

// 🪟 Floating Windows
window-rule {
    match is-floating=true
    opacity 1.0
    draw-border-with-background false
    shadow {
        on
        softness 10
        spread 10
        offset x=0 y=12
    }
}

