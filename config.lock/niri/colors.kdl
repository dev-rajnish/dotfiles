// =============================================================================
//  Wallust Generated Niri Appearance & Border Colors
// =============================================================================

layout {
    background-color "#1E1E2E"

    border {
        active-color "#89B4FA"
        inactive-color "#6C7086"
        urgent-color "#F38BA8"
    }

    focus-ring {
        active-color "#89B4FA"
        inactive-color "#6C7086"
        urgent-color "#F38BA8"
    }

    shadow {
        color "#00000080"
    }

    tab-indicator {
        active-color "#89B4FA"
        inactive-color "#6C7086"
        urgent-color "#F38BA8"
    }

    insert-hint {
        color "#89B4FA80"
    }
}

overview {
    backdrop-color "#1E1E2Ee0"
}
