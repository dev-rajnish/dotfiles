// =============================================================================
//  Auto-generated by sl-render - Niri Keybindings (keybinds.kdl)
// =============================================================================

binds {
    // -------------------------------------------------------------------------
    // 01. System & Session Binds
    // -------------------------------------------------------------------------
    Mod+Shift+E hotkey-overlay-title="Power & Session Menu: Fuzzel" { spawn "power-menu"; }
    Ctrl+Alt+Delete hotkey-overlay-title="Power & Session Menu: Fuzzel" { spawn "power-menu"; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Slash { show-hotkey-overlay; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // -------------------------------------------------------------------------
    // 02. Application Launchers & Utilities
    // -------------------------------------------------------------------------
    Super+Return hotkey-overlay-title="Terminal: Kitty" { spawn "kitty"; }
    Super+E hotkey-overlay-title="File Manager: Thunar" { spawn "thunar"; }
    Super+A hotkey-overlay-title="Application Launcher: Fuzzel" { spawn "fuzzel"; }
    Mod+B hotkey-overlay-title="Web Browser: Librewolf" { spawn "librewolf"; }
    Super+Alt+L hotkey-overlay-title="Lock Screen: Swaylock" { spawn "swaylock"; }
    Mod+N hotkey-overlay-title="Status Bar: Toggle Wayle" { spawn-sh "wayle panel toggle || wayle shell"; }
    Mod+C { spawn-sh "cliphist list | fuzzel -d | cliphist decode | wl-copy"; }
    Mod+Shift+W hotkey-overlay-title="Wallpaper Setter: Waypaper" { spawn-sh "wallpaper --gui"; }

    // -------------------------------------------------------------------------
    // 03. Hardware & Media Keys
    // -------------------------------------------------------------------------
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "pamixer -i 5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "pamixer -d 5"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "pamixer -i 5 --allow-boost"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "pamixer -t"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "brightnessctl s 5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl s 5%-"; }

    // -------------------------------------------------------------------------
    // 04. Window Management & Actions
    // -------------------------------------------------------------------------
    Mod+Q { close-window; }
    Mod+O { toggle-overview; }
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+F { fullscreen-window; }

    // -------------------------------------------------------------------------
    // 05. Focus Navigation
    // -------------------------------------------------------------------------
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+S { focus-column-right; }
    Mod+L { focus-column-left; }

    // -------------------------------------------------------------------------
    // 06. Move Columns & Windows
    // -------------------------------------------------------------------------
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // -------------------------------------------------------------------------
    // 07. Workspaces
    // -------------------------------------------------------------------------

    // -------------------------------------------------------------------------
    // 08. Sizing & Presets
    // -------------------------------------------------------------------------
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { reset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
}
