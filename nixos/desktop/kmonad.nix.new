# =============================================================================
#  KMonad Advanced Low-Level Keyboard Layer Manager
# =============================================================================
{
  pkgs,
  username,
  keyboardPath ? null,
  ...
}: let
  byPath = "/dev/input/by-path";
  autoKeyboardPath =
    if builtins.pathExists byPath
    then let
      files = builtins.attrNames (builtins.readDir byPath);
      kbdFiles = builtins.filter (f: builtins.match ".*-event-kbd" f != null || builtins.match ".*kbd.*" f != null) files;
    in
      if kbdFiles != []
      then "${byPath}/${builtins.head kbdFiles}"
      else "/dev/input/by-path/platform-i8042-serio-0-event-kbd"
    else "/dev/input/by-path/platform-i8042-serio-0-event-kbd";

  kbdDevice =
    if keyboardPath != null && keyboardPath != ""
    then keyboardPath
    else autoKeyboardPath;
in {
  environment.systemPackages = [pkgs.kmonad];

  hardware.uinput.enable = true;
  services.udev.extraRules = ''KERNEL=="uinput", OWNER="${username}", MODE="0600"'';
  users.users.${username}.extraGroups = ["input"];

  services.kmonad = {
    enable = true;
    package = pkgs.kmonad;

    keyboards."my-laptop" = {
      device = kbdDevice;
      config =
        /*
        py
        */
        ''
          ( defcfg
            input  ( device-file "${kbdDevice}" )
            output ( uinput-sink "kmonad-output" )
            fallthrough true
          )

          ;; ╭────────────────────────────────────────────────────────────────────────────────────────╮
          ;; │ PHYSICAL SOURCE LAYOUT (defsrc)                                                        │
          ;; ╰────────────────────────────────────────────────────────────────────────────────────────╯
          ( defsrc
            esc        f1   f2   f3   f4   f5   f6        f7   f8   f9   f10  f11  f12        ins   print  del
            grv        1    2    3    4    5              6    7    8    9    0    -          =     bspc

            ;; OUTER   LEFT HAND (5 keys)             RIGHT HAND (5 keys)            OUTER
            ;;         Pink Ring Mid  Idx  Innr       Innr Idx  Mid  Ring Pink
            tab        q    w    e    r    t              y    u    i    o    p               [     ]      \
            caps       a    s    d    f    g              h    j    k    l    ;               '     ret
            lsft       z    x    c    v    b              n    m    ,    .    /               rsft  up
            lctl       fn   lmet lalt            spc                 ralt rctl            left  down   rght
          )

          ;; ╭────────────────────────────────────────────────────────────────────────────────────────╮
          ;; │ 1. MAIN LAYER (deflayer main)                                                          │
          ;; ╰────────────────────────────────────────────────────────────────────────────────────────╯
          ( deflayer main
            tab        f1   f2   f3   f4   f5   f6        f7   f8   f9   f10  f11  f12        ins   print  @hardl
            grv        1    2    3    4    5              6    7    8    9    0    -          ]     caps

            ;; OUTER   LEFT HAND (5 keys)             RIGHT HAND (5 keys)            OUTER
            ;;         Pink Ring Mid  Idx  Innr       Innr Idx  Mid  Ring Pink
            bspc       p    t    f    b    z              \    '    h    d    -               /     =      \
            @esct      r    l    s    n    x              k    e    a    i    o               u     ret
            lsft       g    j    m    v    q              y    c    ,    .    w               rsft  up
            lalt       fn   lmet @at             spc                 @altn _              left  down   rght
          )

          ;; ╭────────────────────────────────────────────────────────────────────────────────────────╮
          ;; │ 2. QWERTY FALLBACK LAYER (deflayer qwerty)                                             │
          ;; ╰────────────────────────────────────────────────────────────────────────────────────────╯
          ( deflayer qwerty
            esc        f1   f2   f3   f4   f5   f6        f7   f8   f9   f10  f11  f12        _     _      @mainl
            grv        1    2    3    4    5              6    7    8    9    0    -          =     bspc

            ;; OUTER   LEFT HAND (5 keys)             RIGHT HAND (5 keys)            OUTER
            ;;         Pink Ring Mid  Idx  Innr       Innr Idx  Mid  Ring Pink
            tab        q    w    e    r    t              y    u    i    o    p               [     ]      \
            caps       a    s    d    f    g              h    j    k    l    ;               '     ret
            lsft       z    x    c    v    b              n    m    ,    .    /               rsft  up
            lalt       fn   lmet @at             spc                 @altn rctl           left  down   rght
          )

          ;; ╭────────────────────────────────────────────────────────────────────────────────────────╮
          ;; │ 3. NAVIGATION & SYMBOLS LAYER (deflayer arrow-key)                                     │
          ;; ╰────────────────────────────────────────────────────────────────────────────────────────╯
          ( deflayer arrow-key
            _          _    _    _    _    _    _         _    _    _    _    _    _          _     _      _
            _          _    _    _    _    _              _    _    _    _    _    _          _     _

            ;; OUTER   LEFT HAND (5 keys)             RIGHT HAND (5 keys)            OUTER
            ;;         Pink Ring Mid  Idx  Innr       Innr Idx  Mid  Ring Pink
            _          *    $    %    &    ?              \\   #    up   "    \_              ^     _      _
            _          \(   {    [    /    +              =    left down rght rght            :     _
            _          \)   }    ]    @    |              !    ~    <    >    ;               _     _
            _          _    _    _               spc                 _    _               _     _      _
          )

          ;; ╭────────────────────────────────────────────────────────────────────────────────────────╮
          ;; │ 4. NUMPAD LAYER (deflayer number)                                                      │
          ;; ╰────────────────────────────────────────────────────────────────────────────────────────╯
          ( deflayer number
            _          _    _    _    _    _    _         _    _    _    _    _    _          _     _      _
            _          _    _    _    _    _              _    _    _    _    _    _          _     _

            ;; OUTER   LEFT HAND (5 keys)             RIGHT HAND (5 keys)            OUTER
            ;;         Pink Ring Mid  Idx  Innr       Innr Idx  Mid  Ring Pink
            _          _    _    _    _    _              _    _    7    8    _               .     _      _
            _          _    _    _    _    _              _    1    2    3    4               5     _
            _          _    _    _    _    _              0    6    _    _    9               _     _
            _          _    _    _               spc                 _    _               _     _      _
          )

          ;; ╭────────────────────────────────────────────────────────────────────────────────────────╮
          ;; │ 5. ALIASES & MACROS (defalias)                                                         │
          ;; ╰────────────────────────────────────────────────────────────────────────────────────────╯
          ( defalias
            at    (tap-hold-next 80  spc  (layer-toggle arrow-key))
            altn  (tap-hold-next 80  lalt (layer-toggle number))
            hardl (layer-switch qwerty)
            mainl (layer-switch main)
            esct  (tap-hold-next 250 esc  lctl)
          )
        '';
    };
  };
}
